{
  "name": "nest-arch-guard",
  "version": "0.1.0",
  "description": "Architecture tests for NestJS that understand modules, providers and exports, not just file imports.",
  "keywords": [
    "nestjs",
    "architecture",
    "modular-monolith",
    "boundaries",
    "dependency-rules",
    "lint",
    "ci",
    "mermaid"
  ],
  "homepage": "https://github.com/nuttakulsv/nest-arch-guard#readme",
  "bugs": {
    "url": "https://github.com/nuttakulsv/nest-arch-guard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuttakulsv/nest-arch-guard.git"
  },
  "license": "MIT",
  "author": "nuttakulsv",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "nest-arch-guard": "dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "images": "npm run build && node scripts/readme-images.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "vitest": "^5.0.3"
  }
}
